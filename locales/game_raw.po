msgid "Funny. We were about to say the same thing about you."
msgstr ""

msgctxt "Ingame/twin_jets_in_mission#4"
msgid "Run along, little bounty hunter, unless you want us to take your ship apart for you."
msgstr ""

msgctxt "Ingame/twin_jets_in_mission#5"
