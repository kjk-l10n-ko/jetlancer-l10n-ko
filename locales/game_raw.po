msgctxt "Ingame/twin_jets_in_mission#7"
msgid "It's two idiots [c=01]flying[/c] two jets."
msgstr ""

msgctxt "Ingame/twin_jets_in_mission#8"
msgid "[t=010]... [t=100]Let's get her, Hex."
msgstr ""

msgctxt "Ingame/twin_jets_in_mission#9"
msgid "Roger that, Lex."
